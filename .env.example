# Copy this file to `.env` and fill in your values. `.env` is gitignored.

# Turn.io Data Export API bearer token (from your Turn.io account).
TURN_TOKEN=your_turn_io_token_here

# Absolute path to your dissemination roster CSV. This file contains phone
# numbers, so keep it OUTSIDE this repo. Required columns:
#   MobileNo, ppbno, district_name, mandal_name, cluster_name, village_name
TURN_DISSEM_PATH=/absolute/path/to/dissemination_roster.csv

# --- optional overrides (sensible defaults shown) ---
# TURN_BASE_URL=https://whatsapp.turn.io/v1/data
# TURN_DATA_DIR=./data
# TURN_REFERENCE_DIR=./reference
